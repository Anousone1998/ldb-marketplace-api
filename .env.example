# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=*
# Express "trust proxy" (false | true | hop count | subnets). docker-compose sets true for the Cloudflare tunnel.
TRUST_PROXY=false

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Direct:  postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# Pooler:  postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# SSL is required by Supabase (uses ssl: { rejectUnauthorized: false }). Set false only for a local Postgres.
DB_SSL=true
DB_POOL_MAX=10
# Run pending migrations automatically on app start
DB_MIGRATIONS_RUN=true
# Never enable in production; schema is managed by migrations
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Supabase Storage ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_NAME=marketplace

# ─── Auth (login with userId + phone number → HS256 JWT) ─────────────────────
# Signs access tokens. At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
# Access token lifetime in seconds (8 hours)
JWT_EXPIRES_IN=28800
# Optional: "iss" claim added to and required on tokens
JWT_ISSUER=
